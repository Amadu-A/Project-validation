# .env.example

COMPOSE_PROJECT_NAME=project-validation-ai

# Без COMPOSE_PROFILES запускается основной  без User/Auth/Admin/Review.
# Профиль auth требует identity: COMPOSE_PROFILES=identity,auth.
# Корпоративный AD включается отдельным AUTH_SERVICE_ENABLED ниже.
COMPOSE_PROFILES=

# Единая embedding identity .
#
# Business project использует только stable logical shared alias.
# Physical checkpoint, revision и GPU placement принадлежат
# shared-infrastructure.
#
# Schema v2 фиксирует переход с project-local SentenceTransformer runtime
# на resident shared vLLM pooling runtime.
PDRD_EMBEDDING_MODEL=shared-embedding

PDRD_SHARED_EMBEDDING_BASE_URL=http://shared-embedding:8000/v1

